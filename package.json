{
  "name": "lumiere-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Live inventory tracking for Lumière Pâtisserie — Google Sheets source of truth, Railway-hosted",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "seed": "node scripts/seed-sheet.js"
  }
}
