# Copy to server/.env for local dev, or set these as Railway variables.
# Leave GOOGLE_SERVICE_ACCOUNT_JSON and SHEET_ID unset to run in local mode
# (JSON store seeded from data/inventory_seed.csv — no Google setup needed).

# --- Google Sheets mode (set both to enable) ---
# Base64 of the service-account JSON key file, or the raw JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet ID from the sheet URL: .../spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Inventory
UNITS_TAB=Units

# --- App ---
PORT=3000
APP_PASSWORD=lumiere
WEBHOOK_SECRET=change-me
POLL_INTERVAL_MS=60000
